# Postgres connection
DATABASE_URL=postgres://sweeptrack:sweeptrack@localhost:5432/sweeptrack
# Domain used for per-user inbound forwarding addresses (u-<token>@in.<domain>)
INBOUND_EMAIL_DOMAIN=in.sweeptrack.local
# Shared secret your inbound email provider sends in the X-Inbound-Secret header
INBOUND_WEBHOOK_SECRET=change-me
