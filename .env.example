# --- Required ---
DATABASE_URL=postgres://sweeptrack:sweeptrack@localhost:5432/sweeptrack
# Public URL of the app (OAuth redirects, links)
APP_URL=http://localhost:4100
# 32 random bytes, base64 (openssl rand -base64 32) — encrypts mailbox tokens
ENCRYPTION_KEY=
# Domain for forwarding addresses: u-<token>@<domain> per user, catalog@<domain> for newsletters
INBOUND_EMAIL_DOMAIN=in.sweeptrack.local
# Shared secret sent by the email worker in X-Inbound-Secret
INBOUND_WEBHOOK_SECRET=change-me
# Bearer token Cloud Scheduler sends to /api/cron/tick
CRON_SECRET=change-me-too

# --- Admin ---
# Comma-separated emails with admin access (sources, mail-service queue, catalog edits)
ADMIN_EMAILS=

# --- Optional: Claude-assisted rules extraction ---
ANTHROPIC_API_KEY=
# Default claude-opus-5-5; claude-haiku-5-5 is much cheaper if quality holds
RULES_LLM_MODEL=

# --- Optional: connect Gmail / Outlook ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Optional: mail-on-behalf AMOE service (get legal sign-off first) ---
MAIL_SERVICE_ENABLED=false
